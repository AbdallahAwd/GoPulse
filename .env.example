# Copy to .env and replace the empty value with: openssl rand -hex 32
# Keep this secret stable across restarts to preserve sessions.
GOPULSE_AUTH_JWT_SECRET=

# Defaults; config.yaml is optional.
GOPULSE_SERVER_HOST=127.0.0.1
GOPULSE_SERVER_PORT=8080
# Enable for HTTPS deployments behind a separately managed reverse proxy.
GOPULSE_AUTH_SECURE_COOKIES=false
# Optional isolated state directory. Dashboard-approved SSH host keys persist here.
# A verified SSH host key file is an optional fallback for servers without a saved pin:
# GOPULSE_DATA_DIR=/path/to/private/state
# GOPULSE_SSH_KNOWN_HOSTS=/path/to/verified_known_hosts
# Optional GitHub OAuth application (configure an exact HTTPS callback in production):
# GOPULSE_GITHUB_CLIENT_ID=
# GOPULSE_GITHUB_CLIENT_SECRET=
# GOPULSE_GITHUB_CALLBACK_URL=https://dashboard.example.com/auth/github/callback
